          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, cache) (rate(llm_gateway_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{cache}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, cache) (rate(llm_gateway_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{cache}}"
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Upstream errors by reason",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
