            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (tenant) (rate(llm_gateway_tenant_spend_usd_total[5m])) * 3600",
          "legendFormat": "{{tenant}}"
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
